PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Supabase Postgres connection string (Project Settings -> Database -> Connection string).
# Use the pooler string (Transaction or Session mode) unless you know your network has
# working IPv6 egress — the direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Your project's base URL (Project Settings -> API). Used to fetch Supabase's JWKS
# endpoint for verifying access tokens locally (works for both the legacy shared-secret
# HS256 signing and the newer per-project asymmetric ES256 signing keys).
SUPABASE_URL=https://your-project-ref.supabase.co

# Groq API key (console.groq.com) — powers the AI assistant, conflict detector, and
# AI summaries. Server-side only; never prefix this with VITE_ or read it from the client.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
